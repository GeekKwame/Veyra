# Django Settings
DEBUG=True
SECRET_KEY=veyra-dev-secret-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 16)
# For local dev without docker, can set USE_SQLITE=True
USE_SQLITE=True
DATABASE_URL=postgres://veyra_user:veyra_password@localhost:5432/veyra_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
